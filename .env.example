# Copy to .env and fill in. Never commit .env.

# LLM provider: scripted (default, no network) | ollama | anthropic (opt-in only)
LLM_PROVIDER=scripted

# Ollama (local model)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Anthropic (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Upload limits
MAX_FILE_MB=10
MAX_PAGES=50
MAX_FILES=10

# CORS: the only origin allowed to call the backend
FRONTEND_ORIGIN=http://localhost:3000
